{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Navo AI Run (run.bat)",
      "type": "shell",
      "command": "${workspaceFolder}\\run.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
# ==============================================================================
# Navo AI - Konfiguratsiya namunasi (.env.example)
# Haqiqiy maxfiy qiymatlarni .env fayliga yozing.
# ==============================================================================

# Server sozlamalari
HOST=0.0.0.0
PORT=5507
ENVIRONMENT=production
# production yoki development

# Domen va CORS manzillari (Reverse proxy / VPS / domen uchun)
APP_ORIGIN=https://yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Xavfsizlik (Production'da kamida 32 ta belgidan iborat tasodifiy kalit bo'lishi shart)
# Masalan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Reverse proxy (Nginx / Cloudflare) ortida ishlash uchun ruxsat etilgan IP manzillar
FORWARDED_ALLOW_IPS=*

# Google Gemini AI sozlamalari
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Google OAuth (Kirish va ro'yxatdan o'tish)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Email yetkazib berish provayderi: smtp | resend | brevo (standart: smtp)
EMAIL_PROVIDER=smtp

# 1) SMTP sozlamalari (Gmail, Yandex, Mail.ru yoki boshqa)
# Eslatma: Gmail uchun 2-bosqichli tekshiruv va "App Password" (Ilova paroli) kerak
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 2) Resend HTTP API sozlamalari (chiquvchi SMTP bloklangan bo'lsa)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=Navo AI <onboarding@resend.dev>

# 3) Brevo HTTP API sozlamalari (muqobil HTTP API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# SMS xizmati (Eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# OTP va ishlab chiqish sozlamalari
# Production'da DEV_SHOW_OTP majburan o'chiq bo'ladi
DEV_SHOW_OTP=false
OTP_MODE=live
DAILY_MESSAGE_LIMIT=30

# Ma'lumotlar bazasi (bo'sh qolsa SQLite app.db ishlatiladi)
DATABASE_URL=
REQUIRE_DATABASE_URL=false
NAVO_DB_PATH=